# ---------------------------------------------------------------------
# Conexión a Supabase
# ---------------------------------------------------------------------
# Connection string de Postgres (Supabase > Project Settings > Database).
# Usa el pooler (puerto 6543) para despliegues serverless.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Supabase > Project Settings > API > JWT Settings > JWT Secret.
# Con este secreto el backend firma tokens que supabase-js acepta,
# de modo que las políticas RLS aplican al usuario que inició sesión.
SUPABASE_JWT_SECRET=<jwt_secret>

# ---------------------------------------------------------------------
# Sesión
# ---------------------------------------------------------------------
JWT_EXPIRA_HORAS=8
OTP_LONGITUD=6
OTP_VIGENCIA_MINUTOS=10
OTP_MAX_INTENTOS=5
OTP_MAX_ENVIOS_HORA=5

# ---------------------------------------------------------------------
# Correo (Google Workspace / SMTP)
# ---------------------------------------------------------------------
# Con Google Workspace: host smtp.gmail.com, puerto 587, usuario la cuenta
# corporativa y contraseña de aplicación (no la contraseña normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-responder@itsanet.com.ec
SMTP_PASSWORD=<contrasena_de_aplicacion>
SMTP_REMITENTE=Talento Humano ITSANET <no-responder@itsanet.com.ec>
SMTP_STARTTLS=true
# "console" imprime el correo (y el código de acceso) en la terminal en vez de
# enviarlo: permite probar sin configurar nada de SMTP. En producción: smtp.
EMAIL_BACKEND=console

# ---------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------
APP_NOMBRE=Sistema de Permisos y Vacaciones ITSANET
APP_URL=http://localhost:5500

# Orígenes (esquema + host + puerto) desde los que el navegador puede llamar a
# la API. OJO: http://localhost:5500 y http://127.0.0.1:5500 son orígenes
# DISTINTOS para el navegador; si el frontend se sirve desde uno y aquí está el
# otro, el preflight responde 400 y la pantalla dice «No se pudo conectar con
# el servidor». Con ENTORNO=desarrollo se acepta además cualquier puerto local
# (Live Server usa 5500 o 5501), así que no hace falta perseguir el puerto.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# desarrollo | produccion. En produccion se cierran /docs y /openapi.json, se
# envía HSTS y SOLO valen los orígenes listados arriba (nada de localhost).
# Al publicar, cambie estas cuatro líneas:
#   APP_URL=https://permisos.itsanet.com.ec
#   CORS_ORIGINS=https://permisos.itsanet.com.ec
#   EMAIL_BACKEND=smtp
#   ENTORNO=produccion
ENTORNO=desarrollo
