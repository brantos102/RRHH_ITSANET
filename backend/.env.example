# ---------------------------------------------------------------------
# Conexión a Supabase
# ---------------------------------------------------------------------
# Connection string de Postgres (Supabase > Project Settings > Database).
# Usa el pooler (puerto 6543) para despliegues serverless.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Supabase > Project Settings > API > JWT Settings > JWT Secret.
# Con este secreto el backend firma tokens que supabase-js acepta,
# de modo que las políticas RLS aplican al usuario que inició sesión.
SUPABASE_JWT_SECRET=<jwt_secret>

# ---------------------------------------------------------------------
# Sesión
# ---------------------------------------------------------------------
JWT_EXPIRA_HORAS=8
OTP_LONGITUD=6
OTP_VIGENCIA_MINUTOS=10
OTP_MAX_INTENTOS=5
OTP_MAX_ENVIOS_HORA=5

# ---------------------------------------------------------------------
# Correo (Google Workspace / SMTP)
# ---------------------------------------------------------------------
# Con Google Workspace: host smtp.gmail.com, puerto 587, usuario la cuenta
# corporativa y contraseña de aplicación (no la contraseña normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-responder@itsanet.com.ec
SMTP_PASSWORD=<contrasena_de_aplicacion>
SMTP_REMITENTE=Talento Humano ITSANET <no-responder@itsanet.com.ec>
SMTP_STARTTLS=true
# En desarrollo, "console" imprime el correo en la terminal en vez de enviarlo.
EMAIL_BACKEND=smtp

# ---------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------
APP_NOMBRE=Sistema de Permisos y Vacaciones ITSANET
APP_URL=https://permisos.itsanet.com.ec
CORS_ORIGINS=https://permisos.itsanet.com.ec,http://localhost:5500
ENTORNO=produccion
